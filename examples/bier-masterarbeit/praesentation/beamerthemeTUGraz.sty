% ────────────────────────────────────────────
%  beamerthemeTUGraz — schlichtes Beamer-Theme im Stil der TU Graz
%  Offizielles Logo: Datei "tugraz-logo.pdf" (oder .png) in diesen
%  Ordner legen — sonst wird ein Platzhalter-Schriftzug verwendet.
% ────────────────────────────────────────────
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{beamerthemeTUGraz}[2026/10/09 TU Graz Beamer Theme]

\RequirePackage{tikz}
\RequirePackage[default]{sourcesanspro}
\RequirePackage[T1]{fontenc}

% ── Farben ──────────────────────────────────
\definecolor{tured}{RGB}{230,30,80}
\definecolor{tudark}{RGB}{35,35,40}
\definecolor{tugray}{RGB}{120,120,128}
\definecolor{tulight}{RGB}{243,243,245}

\setbeamercolor{normal text}{fg=tudark,bg=white}
\setbeamercolor{structure}{fg=tured}
\setbeamercolor{alerted text}{fg=tured}
\setbeamercolor{frametitle}{fg=tudark}
\setbeamercolor{framesubtitle}{fg=tugray}
\setbeamercolor{title}{fg=tudark}
\setbeamercolor{subtitle}{fg=tugray}
\setbeamercolor{block title}{fg=white,bg=tured}
\setbeamercolor{block body}{fg=tudark,bg=tulight}
\setbeamercolor{block title alerted}{fg=white,bg=tudark}
\setbeamercolor{block body alerted}{fg=tudark,bg=tulight}
\setbeamercolor{block title example}{fg=tured,bg=tulight}
\setbeamercolor{block body example}{fg=tudark,bg=tulight}
\setbeamercolor{footline}{fg=tugray}
\setbeamercolor{item}{fg=tured}

% ── Schrift ─────────────────────────────────
\setbeamerfont{frametitle}{size=\Large,series=\bfseries}
\setbeamerfont{framesubtitle}{size=\normalsize,series=\mdseries}
\setbeamerfont{title}{size=\huge,series=\bfseries}
\setbeamerfont{subtitle}{size=\large}
\setbeamerfont{footline}{size=\tiny}
\setbeamerfont{block title}{series=\bfseries}
\usefonttheme{professionalfonts}

% ── Logo ────────────────────────────────────
\newcommand{\tugrazlogo}[1][1.2cm]{%
  \IfFileExists{tugraz-logo.pdf}{\includegraphics[height=#1]{tugraz-logo.pdf}}{%
  \IfFileExists{tugraz-logo.png}{\includegraphics[height=#1]{tugraz-logo.png}}{%
    \begin{tikzpicture}[x=#1/4.2,y=#1/4.2,baseline=(base)]
      \coordinate (base) at (0,0);
      \foreach \x/\y in {0/2,1/2,2/2,1/1,0/0,1/0,2/0}{\fill[tured] (\x*1.08,\y*1.08) rectangle ++(1,1);}
      \node[anchor=west,inner sep=0,font=\bfseries\sffamily\fontsize{14}{14}\selectfont,text=tudark] at (3.5,1.55) {TU Graz};
    \end{tikzpicture}}}}

% ── Elemente ────────────────────────────────
\setbeamertemplate{navigation symbols}{}
\setbeamertemplate{itemize item}{\raisebox{0.18ex}{\rule{0.55ex}{0.55ex}}}
\setbeamertemplate{itemize subitem}{\raisebox{0.25ex}{\color{tugray}\rule{0.45ex}{0.45ex}}}
\setbeamertemplate{enumerate item}{\insertenumlabel.}
\setbeamertemplate{blocks}[rounded][shadow=false]
\setbeamertemplate{caption}[numbered]
\setbeamersize{text margin left=10mm, text margin right=10mm}

% Kopfzeile: Logo rechts oben, dünne rote Linie
\setbeamertemplate{headline}{%
  \begin{tikzpicture}[remember picture,overlay]
    \node[anchor=north east,inner sep=0] at ([xshift=-8mm,yshift=-5mm]current page.north east) {\tugrazlogo[0.75cm]};
  \end{tikzpicture}}

\setbeamertemplate{frametitle}{%
  \vspace*{5mm}%
  \begin{beamercolorbox}[wd=\paperwidth,leftskip=10mm,rightskip=38mm]{frametitle}
    \usebeamerfont{frametitle}\insertframetitle\par
    \ifx\insertframesubtitle\@empty\else
      \vspace{0.6ex}{\usebeamerfont{framesubtitle}\usebeamercolor[fg]{framesubtitle}\insertframesubtitle\par}%
    \fi
  \end{beamercolorbox}%
  \vspace{-1mm}{\color{tured}\hspace*{10mm}\rule{12mm}{1.2pt}}\vspace{2mm}}

% Fußzeile
\setbeamertemplate{footline}{%
  \usebeamerfont{footline}\usebeamercolor[fg]{footline}%
  \hspace*{10mm}\insertshortauthor\ \ \textbar\ \ \insertshorttitle\hfill
  \insertshortdate\hspace*{6mm}{\color{tured}\bfseries\insertframenumber}\hspace*{10mm}%
  \vspace*{4mm}}

% Titelfolie (absolut positioniert, damit nichts mit dem Logo kollidiert)
\setbeamertemplate{title page}{%
  \begin{tikzpicture}[remember picture,overlay]
    \fill[tured] (current page.south west) rectangle ([yshift=7mm]current page.south east);
    \node[anchor=north west,inner sep=0] at ([xshift=10mm,yshift=-9mm]current page.north west) {\tugrazlogo[1.1cm]};
    \node[anchor=north west,inner sep=0,text width=0.8\paperwidth,align=left]
      at ([xshift=10mm,yshift=-29mm]current page.north west) {%
        {\usebeamerfont{title}\usebeamercolor[fg]{title}\inserttitle\par}
        \vspace{2.5mm}
        {\usebeamerfont{subtitle}\usebeamercolor[fg]{subtitle}\insertsubtitle\par}
        \vspace{8mm}
        {\color{tured}\rule{18mm}{1.5pt}}\par\vspace{4mm}
        {\large\bfseries\insertauthor\par}
        \vspace{1.5mm}
        {\small\color{tugray}\insertinstitute\par}
        \vspace{1mm}
        {\small\color{tugray}\insertdate\par}};
  \end{tikzpicture}}

% Deutsches Datum, falls babel-german fehlt
\AtBeginDocument{\@ifpackageloaded{babel}{}{%
  \renewcommand{\today}{\number\day.~\ifcase\month\or Jänner\or Februar\or März\or April\or Mai\or Juni\or Juli\or August\or September\or Oktober\or November\or Dezember\fi~\number\year}}}

% Abschnittsfolie: vollflächig rot
\AtBeginSection[]{%
  {\setbeamertemplate{headline}{}\setbeamertemplate{footline}{}%
   \setbeamercolor{background canvas}{bg=tured}%
   \begin{frame}[plain,noframenumbering]
     \vfill
     {\color{white!80!tured}\large\sffamily Abschnitt \insertsectionnumber\par}\vspace{2mm}
     {\color{white}\fontsize{30}{36}\selectfont\bfseries\insertsectionhead\par}
     \vspace{6mm}{\color{white}\rule{18mm}{1.5pt}}
     \vfill
   \end{frame}}}

% Abschlussfolie
\newcommand{\danke}[1][Vielen Dank für Ihre Aufmerksamkeit]{%
  {\setbeamertemplate{footline}{}%
   \begin{frame}[plain,noframenumbering]
     \centering\vfill
     {\fontsize{26}{32}\selectfont\bfseries #1\par}
     \vspace{6mm}{\color{tured}\rule{18mm}{1.5pt}}\par\vspace{6mm}
     {\large\color{tugray}Fragen \& Diskussion\par}
     \vfill
   \end{frame}}}

\endinput
